package lll.bridge.termux;

import android.app.Activity;
import android.content.Intent;
import android.graphics.Color;
import android.graphics.drawable.GradientDrawable;
import android.os.Bundle;
import android.view.Gravity;
import android.view.View;
import android.view.inputmethod.InputMethodManager;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.TextView;

import com.google.android.material.textfield.TextInputEditText;
import com.google.android.material.textfield.TextInputLayout;

/**
 * Transparent full-screen activity that collects text for overlay textinput
 * fields. The overlay window itself never takes focus (that would swallow
 * system back / other IME interactions), so a tap on an overlay input opens
 * this activity, which is a real focused window: IME, back navigation and
 * focus behave exactly like a normal app. Result is written back via
 * OverlayManager.completeTextInput(window, nodeId, text).
 *
 * Extras: window, node, title, preset
 */
public class TextInputActivity extends Activity {
    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        Intent it = getIntent();
        String win = it.getStringExtra("window");
        String node = it.getStringExtra("node");
        String title = it.getStringExtra("title");
        String preset = it.getStringExtra("preset");

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setGravity(Gravity.CENTER);
        root.setPadding(48, 48, 48, 48);

        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        GradientDrawable bg = new GradientDrawable();
        bg.setColor(0xFFF7FDFE);
        bg.setCornerRadius(48);
        card.setBackground(bg);
        int pad = (int) (32 * getResources().getDisplayMetrics().density);
        card.setPadding(pad, pad, pad, pad);

        TextView tv = new TextView(this);
        tv.setText(title != null ? title : "输入");
        tv.setTextSize(16);
        tv.setTextColor(0xFF171D1D);
        card.addView(tv);

        TextInputLayout til = new TextInputLayout(this);
        til.setHint("输入内容");
        TextInputEditText et = new TextInputEditText(til.getContext());
        et.setText(preset != null ? preset : "");
        et.setTextSize(15);
        et.setTextColor(0xFF171D1D);
        et.requestFocus();
        til.addView(et, new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT));
        LinearLayout.LayoutParams tlp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
        tlp.topMargin = pad / 2;
        card.addView(til, tlp);

        LinearLayout row = new LinearLayout(this);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.END);
        Button cancel = new Button(this, null, 0);
        cancel.setText("取消");
        cancel.setTextColor(0xFF006972);
        cancel.setOnClickListener(v -> { returnResult(false, win, node, null); });
        Button ok = new Button(this, null, 0);
        ok.setText("确定");
        ok.setTextColor(0xFF006972);
        ok.setOnClickListener(v -> returnResult(true, win, node,
                et.getText() == null ? "" : et.getText().toString()));
        row.addView(cancel);
        row.addView(ok);
        LinearLayout.LayoutParams rlp = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
        rlp.topMargin = pad / 2;
        card.addView(row, rlp);

        LinearLayout.LayoutParams clp = new LinearLayout.LayoutParams(
                (int) (300 * getResources().getDisplayMetrics().density),
                LinearLayout.LayoutParams.WRAP_CONTENT);
        root.addView(card, clp);

        // tap outside the card = cancel
        root.setOnClickListener(v -> returnResult(false, win, node, null));

        setContentView(root);

        // show the IME for the focused field
        et.postDelayed(() -> {
            InputMethodManager imm = (InputMethodManager) getSystemService(INPUT_METHOD_SERVICE);
            if (imm != null) imm.showSoftInput(et, InputMethodManager.SHOW_IMPLICIT);
        }, 200);
    }

    private void returnResult(boolean ok, String win, String node, String text) {
        OverlayManager.completeTextInput(win, node, ok ? text : null);
        finish();
    }

    @Override
    public void onBackPressed() {
        // system back cancels; it reaches us normally because this is a real focused window
        returnResult(false, null, null, null);
    }
}
