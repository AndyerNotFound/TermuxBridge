#!/data/data/com.termux/files/usr/bin/bash
# TermuxBridge CLI — 通过本地 TCP 调用跳板 APP
# 用法: tb <命令> [参数...]  |  tb raw '<json>'
# 环境: TBRIDGE_PORT(默认 8021), TBRIDGE_HOST(默认 127.0.0.1)

set -u
PORT="${TBRIDGE_PORT:-8021}"
HOST="${TBRIDGE_HOST:-127.0.0.1}"

die() { printf '❌ %s\n' "$*" >&2; exit 1; }

# 发一行 JSON, 收一行 JSON。无响应时给出明确错误。
send() {
  local payload="$1" resp
  resp=$(printf '%s\n' "$payload" | nc -w "${TBRIDGE_TIMEOUT:-10}" "$HOST" "$PORT" 2>/dev/null)
  if [ -z "$resp" ]; then
    die "无响应。检查: 1) APP 内已『启动服务』 2) 端口=$PORT 与 APP 设置一致 3) 令牌(TBRIDGE_TOKEN)匹配"
  fi
  printf '%s\n' "$resp"
}

# JSON 字符串转义(纯 bash, 不依赖 jq)
jstr() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

tok_prefix() { [ -n "${TBRIDGE_TOKEN:-}" ] && printf '"token":"%s",' "$TBRIDGE_TOKEN"; }

# 取 JSON 字段值(优先 jq, 回退 python, 再回退 grep)
jget() {
  local key="$1"
  if command -v jq >/dev/null 2>&1; then jq -r ".$key // empty" 2>/dev/null
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys;d=json.load(sys.stdin);v=d.get(sys.argv[1]);print("" if v is None else v)' "$key" 2>/dev/null
  else sed -n "s/.*\"$key\":\"\\([^\"]*\\)\".*/\\1/p"; fi
}

jok() {
  if command -v jq >/dev/null 2>&1; then jq -e '.ok == true' >/dev/null 2>&1
  else grep -q '"ok":true'; fi
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
read -r -d '' USAGE <<'EOF'
TermuxBridge CLI (tb)

  tb ping                         连通性/版本
  tb features                     列出功能开关状态
  tb on <feat> | off <feat>       启用/停用功能模块
  tb toast <文本> [long]          Toast 弹窗
  tb notify <标题> <内容>         通知栏
  tb vibrate [ms]                 振动
  tb beep [success|error|beep]    提示音
  tb clip                         读剪贴板
  tb clip-set <文本>              写剪贴板
  tb battery                      电池
  tb net                          网络
  tb bright [0-255]               屏幕亮度(读/写)
  tb volume [0-100]               音量(notification 流)
  tb torch [on|off]               手电筒
  tb location                     定位
  tb sensors                      传感器列表
  tb sensor <名字>                读传感器(accelerometer/gyroscope/light...)
  tb tts <文本>                   TTS 朗读
  tb record [秒数]                录音 → wav 文件
  tb share <文本>                 分享文本
  tb open <url>                   打开链接
  tb dial <号码>                  拨号盘
  tb sms <号码> [内容]            短信
  tb shot [输出文件]              截图(无障碍, 无弹窗)
  tb shot --mp [输出文件]         截图(MediaProjection, 需点一次授权)
  tb tap <x> <y>                  模拟点击
  tb swipe <x1> <y1> <x2> <y2> [ms]  模拟滑动
  tb ui [深度]                    导出当前界面树(JSON)
  tb a11y                         查无障碍服务状态
  tb a11y-on                      打开无障碍设置页
  tb stt [超时秒]                 语音识别(需在手机上说话)
  tb raw '<json>'                 发送原始 JSON
EOF

case "$cmd" in
  ""|-h|--help|help) printf '%s\n' "$USAGE"; exit 0 ;;

  ping)      send "$(printf '{%s"cmd":"ping"}' "$(tok_prefix)")" | fmt ;;

  features)  send "$(printf '{%s"cmd":"features"}' "$(tok_prefix)")" | fmt ;;

  on|off)
    [ $# -ge 1 ] || die "用法: tb $cmd <feature>"
    v=true; [ "$cmd" = "off" ] && v=false
    send "$(printf '{%s"cmd":"feature","name":"%s","enable":%s}' "$(tok_prefix)" "$1" "$v")" | fmt ;;

  toast)     send "$(printf '{%s"cmd":"toast","text":%s,"duration":"%s"}' \
               "$(tok_prefix)" "$(jstr "${1:-}")" "${2:-short}")" | fmt ;;

  notify)    send "$(printf '{%s"cmd":"notify","title":%s,"text":%s}' \
               "$(tok_prefix)" "$(jstr "${1:-TermuxBridge}")" "$(jstr "${2:?缺内容}")")" | fmt ;;

  vibrate)   send "$(printf '{%s"cmd":"vibrate","ms":%s}' "$(tok_prefix)" "${1:-300}")" | fmt ;;

  beep)      send "$(printf '{%s"cmd":"beep","type":"%s"}' "$(tok_prefix)" "${1:-beep}")" | fmt ;;

  clip)
    # Android 10+ 需焦点: 先让 APP 的透明 Activity 抓一次
    am start -n lll.bridge.termux/.ClipCatchActivity >/dev/null 2>&1
    sleep 0.6
    resp=$(send "$(printf '{%s"cmd":"clip.read"}' "$(tok_prefix)")")
    if printf '%s' "$resp" | jok && command -v jq >/dev/null 2>&1; then
      printf '%s' "$resp" | jq -r '.text'
    else
      printf '%s
' "$resp" | fmt
    fi ;;

  clip-set)
    # 后台写剪贴板会被系统拦截 → 借透明 Activity 获得焦点后写
    txt="${1:?缺文本}"
    am start -n lll.bridge.termux/.ClipCatchActivity --es write "$txt" >/dev/null 2>&1
    sleep 0.8
    send "$(printf '{%s"cmd":"clip.write","text":%s}' "$(tok_prefix)" "$(jstr "$txt")")" | fmt ;;

  battery)   send "$(printf '{%s"cmd":"battery"}' "$(tok_prefix)")" | fmt ;;

  net)       send "$(printf '{%s"cmd":"net"}' "$(tok_prefix)")" | fmt ;;

  bright)
    if [ $# -ge 1 ]; then
      send "$(printf '{%s"cmd":"bright","action":"write","value":%s}' "$(tok_prefix)" "$1")" | fmt
    else
      send "$(printf '{%s"cmd":"bright"}' "$(tok_prefix)")" | fmt
    fi ;;

  volume)
    if [ $# -ge 1 ]; then
      send "$(printf '{%s"cmd":"volume","action":"write","value":%s}' "$(tok_prefix)" "$1")" | fmt
    else
      send "$(printf '{%s"cmd":"volume"}' "$(tok_prefix)")" | fmt
    fi ;;

  torch)     send "$(printf '{%s"cmd":"torch","action":"%s"}' "$(tok_prefix)" "${1:-on}")" | fmt ;;

  location)  send "$(printf '{%s"cmd":"location"}' "$(tok_prefix)")" | fmt ;;

  sensors)   send "$(printf '{%s"cmd":"sensor.list"}' "$(tok_prefix)")" | fmt ;;

  sensor)    send "$(printf '{%s"cmd":"sensor.read","sensor":"%s"}' "$(tok_prefix)" "${1:-accelerometer}")" | fmt ;;

  tts)       send "$(printf '{%s"cmd":"tts","text":%s}' "$(tok_prefix)" "$(jstr "${1:?缺文本}")")" | fmt ;;

  record)
    ms=$(( ${1:-2} * 1000 ))
    out="rec_$(date +%Y%m%d_%H%M%S).wav"
    resp=$(send "$(printf '{%s"cmd":"record","ms":%s}' "$(tok_prefix)" "$ms")")
    if printf '%s' "$resp" | jok; then
      if command -v jq >/dev/null 2>&1; then
        printf '%s' "$resp" | jq -r '.wav_b64' | base64 -d > "$out"
        printf '✅ 已保存: %s\n' "$out"
      else
        printf '%s\n' "$resp"
      fi
    else
      printf '%s\n' "$resp"
    fi ;;

  share)     send "$(printf '{%s"cmd":"share","text":%s}' "$(tok_prefix)" "$(jstr "${1:?缺文本}")")" | fmt ;;

  open)      send "$(printf '{%s"cmd":"open","url":%s}' "$(tok_prefix)" "$(jstr "${1:?缺url}")")" | fmt ;;

  dial)      send "$(printf '{%s"cmd":"dial","tel":"%s"}' "$(tok_prefix)" "${1:?缺号码}")" | fmt ;;

  sms)       send "$(printf '{%s"cmd":"sms","tel":"%s","text":%s}' "$(tok_prefix)" "${1:?缺号码}" "$(jstr "${2:-}")")" | fmt ;;

  shot)
    mode="a11y"; [ "${1:-}" = "--mp" ] && { mode="mp"; shift; }
    out="${1:-shot_$(date +%Y%m%d_%H%M%S).png}"

    if [ "$mode" = "a11y" ]; then
      resp=$(send "$(printf '{%s"cmd":"shot"}' "$(tok_prefix)")")
      if printf '%s' "$resp" | jok; then
        printf '%s' "$resp" | jq -r '.png_b64' | base64 -d > "$out"
        printf '✅ 已保存: %s (%s bytes)\n' "$out" "$(stat -c%s "$out")"
        exit 0
      fi
      case "$resp" in
        *"accessibility service not enabled"*)
          printf '⚠️  无障碍服务未启用, 回退到 MediaProjection(需授权)\n' >&2 ;;
        *) printf '%s\n' "$resp" >&2; exit 1 ;;
      esac
    fi

    # MediaProjection 链路
    am start -n lll.bridge.termux/.ScreenshotActivity >/dev/null 2>&1
    printf '📱 请在系统对话框中允许截屏...\n' >&2
    for i in $(seq 1 30); do
      sleep 2
      resp=$(send "$(printf '{%s"cmd":"shot.poll"}' "$(tok_prefix)")")
      if printf '%s' "$resp" | jok; then
        printf '%s' "$resp" | jq -r '.png_b64' | base64 -d > "$out"
        printf '✅ 已保存: %s (%s bytes)\n' "$out" "$(stat -c%s "$out")"
        exit 0
      fi
      case "$resp" in *pending*|*"no screenshot"*) continue ;; esac
      printf '%s\n' "$resp" >&2
    done
    die "截图超时(未授权或已取消)" ;;

  tap)   send "$(printf '{%s"cmd":"tap","x":%s,"y":%s}' "$(tok_prefix)" "${1:?缺x}" "${2:?缺y}")" | fmt ;;

  swipe) send "$(printf '{%s"cmd":"swipe","x1":%s,"y1":%s,"x2":%s,"y2":%s,"ms":%s}' \
           "$(tok_prefix)" "${1:?缺x1}" "${2:?缺y1}" "${3:?缺x2}" "${4:?缺y2}" "${5:-300}")" | fmt ;;

  ui)    send "$(printf '{%s"cmd":"ui","depth":%s}' "$(tok_prefix)" "${1:-12}")" | fmt ;;

  a11y)  send "$(printf '{%s"cmd":"a11y"}' "$(tok_prefix)")" | fmt ;;

  a11y-on)
    am start -a android.settings.ACCESSIBILITY_SETTINGS >/dev/null 2>&1
    printf '已打开无障碍设置, 找到 TermuxBridge 并开启\n' ;;

  stt)
    am start -n lll.bridge.termux/.SttActivity >/dev/null 2>&1
    printf '🎙️ 请对着手机说话...\n' >&2
    for i in $(seq 1 40); do
      sleep 1
      resp=$(send "$(printf '{%s"cmd":"stt.poll"}' "$(tok_prefix)")")
      if printf '%s' "$resp" | jok; then
        if command -v jq >/dev/null 2>&1; then printf '%s' "$resp" | jq -r '.text'
        else printf '%s\n' "$resp"; fi
        exit 0
      fi
      case "$resp" in *pending*) continue ;; *"no stt"*) continue ;; esac
      printf '%s\n' "$resp" >&2
    done
    die "语音识别超时" ;;

  raw)       send "${1:?缺 JSON}" ;;

  *) die "未知命令: $cmd (tb --help 查看用法)" ;;
esac
